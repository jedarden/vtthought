# VTThought Backend Environment Configuration
# Copy this file to .env and configure your settings

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,vscode-webview://*

# WebSocket Configuration
WS_MAX_CONNECTIONS=10
WS_MESSAGE_QUEUE_SIZE=100

# Audio Configuration (ADR-003, ADR-004)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=4096
MAX_AUDIO_DURATION_SECONDS=300

# STT Configuration (ADR-005)
STT_ENGINE=faster-whisper
STT_MODEL=base
STT_DEVICE=auto
STT_COMPUTE_TYPE=float16

# LLM Configuration (ADR-006)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Authentication (ADR-002)
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (ADR-002) - Recommended for production
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL (for OAuth callback redirect)
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (ADR-002) - Legacy (kept for backwards compatibility)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rate Limiting (ADR-010)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# Cloudflare Tunnel (ADR-009) - Optional
CLOUDFLARE_TUNNEL_TOKEN=

# Observability (ADR-019)
ENABLE_METRICS=true
ENABLE_HEALTH_ENDPOINT=true
